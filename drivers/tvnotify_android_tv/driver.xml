        <name>Default Vendor</name>
        <type>LIST</type>
        <items>
          <item>Auto Detect</item>
          <item>Hikvision NVR</item>
          <item>Hikvision Camera</item>
          <item>Dahua / Amcrest</item>
          <item>Foscam</item>
          <item>Reolink</item>
          <item>Axis</item>
          <item>Other Vendor</item>
        </items>
        <default>Auto Detect</default>
        <readonly>false</readonly>
        <tooltip>Vendor used to build snapshot and stream addresses. Auto Detect = recognised from the camera / NVR driver. Each camera action can override it.</tooltip>
      </property>
