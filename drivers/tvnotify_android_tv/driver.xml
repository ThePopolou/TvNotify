        <name>Address Method</name>
        <type>LIST</type>
        <items>
          <item>Use Device's Own Settings</item>
          <item>Specify Below</item>
        </items>
        <default>Use Device's Own Settings</default>
        <readonly>false</readonly>
        <tooltip>Use Device's Own Settings: the NVR's address and ports are taken from each camera's driver properties. Specify Below: the IP address and ports entered below are used for every camera on the NVR. Cameras not on an NVR always use their own settings.</tooltip>
      </property>
      <property>
        <name>NVR/Camera IP Address</name>
        <type>STRING</type>
        <default></default>
        <readonly>false</readonly>
        <tooltip>The NVR's IP address, used for every camera on the NVR when Address Method is Specify Below.</tooltip>
      </property>
      <property>
        <name>NVR/Camera HTTP Port</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>65535</maximum>
        <default>80</default>
        <readonly>false</readonly>
        <tooltip>Web port used in snapshot addresses with the NVR/Camera IP Address (default 80).</tooltip>
      </property>
      <property>
        <name>NVR/Camera RTSP Port</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>65535</maximum>
        <default>554</default>
        <readonly>false</readonly>
        <tooltip>RTSP port used in live-stream addresses with the NVR/Camera IP Address (default 554).</tooltip>
      </property>
      <property>
        <name>Login Method</name>
        <type>LIST</type>
        <items>
          <item>Use Device's Own Credentials</item>
          <item>Specify Below</item>
        </items>
        <default>Use Device's Own Credentials</default>
        <readonly>false</readonly>
